# New provisioning uses the compiled, reviewed Workspace blueprint release.
# GOOGLE_PROJECT_TEMPLATE_FILE_ID / VERSION are retired from normal Project provisioning.
# Apps Script API must be enabled; user grant adds script.projects (no unrestricted Drive).
# Public Google Picker configuration, same Cloud project as the OAuth client.
VITE_GOOGLE_PICKER_API_KEY=
VITE_GOOGLE_APP_ID=
