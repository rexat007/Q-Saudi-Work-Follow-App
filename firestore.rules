rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Security & Identity Helpers
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAuditStampedCreate(data) {
      return data.createdAt is timestamp &&
             data.createdBy is string && data.createdBy.size() > 0 &&
             data.updatedAt is timestamp &&
             data.updatedBy is string && data.updatedBy.size() > 0;
    }

    function isAuditStampedUpdate(data) {
      return data.updatedAt is timestamp &&
             data.updatedBy is string && data.updatedBy.size() > 0 &&
             (!('createdAt' in existing()) || !('createdAt' in data) || data.createdAt == existing().createdAt) &&
             (!('createdBy' in existing()) || !('createdBy' in data) || data.createdBy == existing().createdBy);
    }

    function hasCurrentUser() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isCurrentUserValid() {
      return hasCurrentUser() &&
        currentUser().get('userId', request.auth.uid) == request.auth.uid &&
        currentUser().get('role', '') in ['PROJECT_ADMIN', 'SUPER_ADMIN', 'SITE_SUPERVISOR', 'SUPERVISOR', 'DISPATCHER', 'FINANCE_AUDITOR', 'SCALE_OPERATOR', 'DRIVER', 'VIEWER'] &&
        currentUser().get('assignedProjectIds', null) is list &&
        currentUser().get('isActive', true) is bool;
    }

    function isUserActive() {
      return isCurrentUserValid() &&
        currentUser().get('status', currentUser().get('isActive', false) == true ? 'ACTIVE' : 'PENDING_APPROVAL') == 'ACTIVE' &&
        currentUser().get('isActive', true) != false;
    }

    function isSuperAdmin() {
      return isUserActive() && currentUser().role == 'SUPER_ADMIN';
    }

    // Current profile owns ordinary admin reads; token claims cannot preserve them.
    function isAdminConsoleReader() {
      return isUserActive() && (
        isSuperAdmin() || currentUser().role == 'PROJECT_ADMIN'
      );
    }

    // Account requests carry no effective privilege or project membership.
    function isSafeAccountRequest(userId) {
      let data = incoming();
      return request.auth.uid == userId &&
             data.keys().hasOnly([
               'userId', 'email', 'fullName', 'role', 'requestedRole', 'requestReason',
               'assignedProjectIds', 'status', 'isActive',
               'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
             ]) &&
             data.email == request.auth.token.email &&
             data.fullName is string && data.fullName.size() > 0 &&
             data.role == 'VIEWER' &&
             data.status == 'PENDING_APPROVAL' &&
             data.isActive == false &&
             data.assignedProjectIds is list && data.assignedProjectIds.size() == 0 &&
             data.createdBy == request.auth.uid && data.updatedBy == request.auth.uid;
    }

    function isServerAuthorized() {
      // Existing infrastructure claims remain separate from human account authority.
      // A user with a canonical profile cannot use stale system claims to bypass it.
      return isSuperAdmin() || (isSignedIn() && !hasCurrentUser() && (
        (request.auth.token.get('isServer', false) == true && !(request.auth.token.get('role', '') in ['PROJECT_ADMIN', 'SUPER_ADMIN', 'SITE_SUPERVISOR', 'SUPERVISOR', 'DISPATCHER', 'FINANCE_AUDITOR', 'SCALE_OPERATOR', 'DRIVER', 'VIEWER'])) || request.auth.token.get('role', '') == 'SYSTEM'
      ));
    }

    function isProjectMember(projectId) {
      return isUserActive() && (
        isSuperAdmin() || projectId in currentUser().assignedProjectIds
      );
    }

    function hasProjectRole(projectId, allowedRoles) {
      return isUserActive() && (
        isSuperAdmin() || (currentUser().role in allowedRoles && projectId in currentUser().assignedProjectIds)
      );
    }

    // =========================================================================
    // 1. Projects Collection & Multi-Tenant Boundaries
    // =========================================================================
    match /projects/{projectId} {
      allow get: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        isProjectMember(projectId)
      );
      allow create: if false; // Direct client-side creation denied to enforce single server-authoritative path
      allow update: if false; // Project commands and Workspace linkage are server authoritative.
      allow delete: if false; // Soft-delete only via status

      // Carriers subcollection
      match /carriers/{carrierId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create: if isSignedIn() && isValidId(carrierId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                         isAuditStampedCreate(incoming()) &&
                         incoming().carrierId == carrierId &&
                         incoming().projectId == projectId;
        allow update: if isSignedIn() && isValidId(carrierId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                         isAuditStampedUpdate(incoming()) &&
                         incoming().carrierId == existing().carrierId &&
                         incoming().projectId == existing().projectId;
        allow delete: if false;
      }

      // Project Carrier Roster subcollection (RETIRED — READ-ONLY)
      match /roster/{rosterId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create, update, delete: if false;
      }

      // Pricing Rules subcollection
      match /pricing_rules/{pricingRuleId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create: if false; // Use canonical server pricing creation.
        allow update: if false; // Canonical server commands enforce versions, lineage and audit.
        allow delete: if false;
      }

      // Materials subcollection
      match /materials/{materialId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create: if isSignedIn() && isValidId(materialId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                         isAuditStampedCreate(incoming()) &&
                         incoming().materialId == materialId &&
                         incoming().projectId == projectId;
        allow update: if isSignedIn() && isValidId(materialId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                         isAuditStampedUpdate(incoming()) &&
                         incoming().materialId == existing().materialId &&
                         incoming().projectId == existing().projectId;
        allow delete: if false;
      }

      // Trucks subcollection (RETIRED — READ-ONLY)
      match /trucks/{truckId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create, update, delete: if false;
      }

      // Drivers subcollection (RETIRED — READ-ONLY)
      match /drivers/{driverId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create, update, delete: if false;
      }

      // =======================================================================
      // PHASE 6 — UNIT 2A: Project Membership Subcollections
      // Client writes denied; server commands reauthorize the current account.
      // Read authority requires active project membership.
      // Enforces structural projectId, audit stamps, and key alignment.
      // =======================================================================
      match /driver_memberships/{driverId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create, update, delete: if false; // Server participation authority only.
      }

      match /truck_memberships/{truckId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create, update, delete: if false; // Server participation authority only.
      }

      match /carrier_memberships/{carrierId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create, update, delete: if false; // Server participation authority only.
      }

      match /material_memberships/{materialId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create, update, delete: if false; // Server participation authority only.
      }

      // =======================================================================
      // PHASE 6 — UNIT 2B-1: Project Carrier Fleet Affiliation Subcollections
      // Client writes denied; server commands reauthorize the current account.
      // Read authority requires active project membership.
      // Enforces structural projectId, driverId/truckId alignment, carrierId validity, and audit stamps.
      // =======================================================================
      match /driver_carrier_affiliations/{driverId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create, update, delete: if false; // Server participation authority only.
      }

      match /truck_carrier_affiliations/{truckId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create, update, delete: if false; // Server participation authority only.
      }

      // Unit 2B-2: Driver ↔ Truck Temporal Assignment Subcollection
      match /driver_truck_assignments/{assignmentId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create, update, delete: if false; // Server temporal authority only.
      }

      // Unit 2B-2: Active Driver Slot Concurrency Infrastructure
      match /driver_active_assignments/{driverId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create, update, delete: if false; // Server temporal authority only.
      }

      // Unit 2B-2: Active Truck Slot Concurrency Infrastructure
      match /truck_active_assignments/{truckId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create, update, delete: if false; // Server temporal authority only.
      }

      // Unit 2C: Truck ↔ Material Temporal Allocation Subcollection
      match /truck_material_allocations/{allocationId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create, update, delete: if false; // Server temporal authority only.
      }

      // Unit 2C: Active Truck Material Slot Concurrency Infrastructure
      match /truck_active_material_allocations/{truckId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create, update, delete: if false; // Server temporal authority only.
      }

      // Trips subcollection
      match /trips/{tripId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create: if false; // Use canonical server dispatch/import commands.
        allow update: if false; // All operational writes use current-principal server business commands.
        allow delete: if false; // Tax/VAT compliance: trips cannot be hard-deleted

        // Trip Events (Strict Append-Only Event Stream)
        match /events/{eventId} {
          allow get, list: if isSignedIn() && isProjectMember(projectId);
          allow create: if false; // Events are emitted atomically by server commands.
          allow update, delete: if false; // Strictly Immutable Event Stream
        }

        // Trip Exceptions
        match /exceptions/{exceptionId} {
          allow get, list: if isSignedIn() && isProjectMember(projectId);
          allow create: if isSignedIn() && isValidId(exceptionId) &&
                           isProjectMember(projectId) &&
                           isAuditStampedCreate(incoming()) &&
                           incoming().exceptionId == exceptionId &&
                           incoming().tripId == tripId &&
                           incoming().projectId == projectId;
          allow update: if isSignedIn() && isValidId(exceptionId) &&
                           hasProjectRole(projectId, ['PROJECT_ADMIN', 'FINANCE_AUDITOR', 'SUPER_ADMIN']) &&
                           isAuditStampedUpdate(incoming()) &&
                           incoming().exceptionId == existing().exceptionId &&
                           incoming().tripId == existing().tripId &&
                           incoming().projectId == existing().projectId;
          allow delete: if false;
        }

        // Settlement Adjustments subcollection (BLOCK 87)
        match /adjustments/{adjustmentId} {
          allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
          allow create: if isSignedIn() && isValidId(adjustmentId) &&
                           hasProjectRole(projectId, ['PROJECT_ADMIN', 'FINANCE_AUDITOR', 'SUPER_ADMIN']) &&
                           isAuditStampedCreate(incoming()) &&
                           incoming().adjustmentId == adjustmentId &&
                           incoming().tripId == tripId &&
                           incoming().projectId == projectId;
          allow update: if isSignedIn() && isValidId(adjustmentId) &&
                           hasProjectRole(projectId, ['PROJECT_ADMIN', 'FINANCE_AUDITOR', 'SUPER_ADMIN']) &&
                           isAuditStampedUpdate(incoming()) &&
                           incoming().adjustmentId == existing().adjustmentId &&
                           incoming().tripId == existing().tripId &&
                           incoming().projectId == existing().projectId;
          allow delete: if false;
        }
      }

      // Sync Operations (Idempotency Journal)
      match /sync_operations/{operationId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create: if isSignedIn() && isValidId(operationId) &&
                         !operationId.matches('^TRIP-CMD-.*') &&
                         isProjectMember(projectId) &&
                         isAuditStampedCreate(incoming()) &&
                         incoming().operationId == operationId &&
                         incoming().projectId == projectId;
        allow update: if isSignedIn() && isValidId(operationId) &&
                         !operationId.matches('^TRIP-CMD-.*') &&
                         isProjectMember(projectId) &&
                         isAuditStampedUpdate(incoming()) &&
                         incoming().operationId == existing().operationId &&
                         incoming().projectId == existing().projectId;
        allow delete: if false;
      }

      // Import Batches
      match /import_batches/{batchId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create: if isSignedIn() && isValidId(batchId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'DISPATCHER', 'SUPERVISOR', 'SUPER_ADMIN']) &&
                         isAuditStampedCreate(incoming()) &&
                         incoming().batchId == batchId &&
                         incoming().projectId == projectId;
        allow update: if isSignedIn() && isValidId(batchId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'DISPATCHER', 'SUPERVISOR', 'SUPER_ADMIN']) &&
                         isAuditStampedUpdate(incoming()) &&
                         incoming().batchId == existing().batchId &&
                         incoming().projectId == existing().projectId;
        allow delete: if false;
      }
    }

    // Collection Group Read Rule for Exceptions
    match /{path=**}/exceptions/{exceptionId} {
      allow get, list: if isSignedIn() && isProjectMember(resource.data.projectId);
    }

    // =========================================================================
    // 2. Global Users Collection
    // =========================================================================
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) &&
                      (request.auth.uid == userId || isAdminConsoleReader());
      allow list: if isAdminConsoleReader();
      allow create: if isSignedIn() && isValidId(userId) &&
                       isAuditStampedCreate(incoming()) && incoming().userId == userId && isSafeAccountRequest(userId);
      // All effective global account mutations use the audited Admin SDK command boundary.
      allow update: if false;
      allow delete: if false;
    }

    // =========================================================================
    // 3. Global Audit Logs Collection (Strict Append-Only with Actor Verification)
    // =========================================================================
    match /audit_logs/{auditLogId} {
      allow get, list: if isAdminConsoleReader();
      allow create: if isUserActive() && isValidId(auditLogId) &&
                       isAuditStampedCreate(incoming()) && incoming().auditLogId == auditLogId &&
                       incoming().entityType != 'USER_ROLE' &&
                       incoming().actor.userId == request.auth.uid &&
                       incoming().actor.role == currentUser().role &&
                       incoming().actor.email == request.auth.token.email &&
                       incoming().createdBy == request.auth.uid && incoming().updatedBy == request.auth.uid &&
                       (isProjectMember(incoming().projectId) ||
                        (isSuperAdmin() && incoming().projectId in ['SYSTEM', 'ALL']));
      allow update, delete: if false; // Strictly Immutable
    }

    // =========================================================================
    // 4. Global Identity Authorities (Phase 6 Unit 1: Additive Foundation Only)
    // Interim restricted policy: SUPER_ADMIN and trusted server-authorized execution only.
    // Zero production consumers wired yet. Ordinary users cannot read arbitrary Driver PII or probe lookup tokens.
    // =========================================================================
    match /drivers/{driverId} {
      allow get, list: if isSuperAdmin() || isServerAuthorized();
      allow create, update: if false; // Global mutations are server authoritative.
      allow delete: if false;
    }

    match /trucks/{truckId} {
      allow get, list: if isSuperAdmin() || isServerAuthorized();
      allow create, update: if false; // Global mutations are server authoritative.
      allow delete: if false;
    }

    match /carriers/{carrierId} {
      allow get, list: if isSuperAdmin() || isServerAuthorized();
      allow create, update: if false; // Global mutations are server authoritative.
      allow delete: if false;
    }

    match /materials/{materialId} {
      // Material catalog is non-sensitive domain master data
      allow get, list: if isUserActive();
      allow create, update: if false; // Global mutations are server authoritative.
      allow delete: if false;
    }

    // Natural Identity Atomic Reservation Lookups
    // Zero ordinary client get/list/write to eliminate low-entropy token enumeration/probing
    match /natural_identity_lookups/{token} {
      allow get, list: if isSuperAdmin() || isServerAuthorized();
      allow create, update, delete: if false; // Reservation is server authoritative.
    }

    // System Counters (Server-Authoritative Only)
    match /systemCounters/{counterId} {
      allow read: if isSuperAdmin() || isServerAuthorized();
      allow write: if false; // Only manageable via Server Admin transactions
    }
  }
}

