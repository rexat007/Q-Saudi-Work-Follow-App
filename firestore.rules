rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Security & Identity Helpers
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAuditStampedCreate(data) {
      return data.createdAt is timestamp &&
             data.createdBy is string && data.createdBy.size() > 0 &&
             data.updatedAt is timestamp &&
             data.updatedBy is string && data.updatedBy.size() > 0;
    }

    function isAuditStampedUpdate(data) {
      return data.updatedAt is timestamp &&
             data.updatedBy is string && data.updatedBy.size() > 0 &&
             (!('createdAt' in existing()) || !('createdAt' in data) || data.createdAt == existing().createdAt) &&
             (!('createdBy' in existing()) || !('createdBy' in data) || data.createdBy == existing().createdBy);
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.isSuperAdmin == true ||
        request.auth.token.role == 'SUPER_ADMIN' ||
        (request.auth.token.email_verified == true && request.auth.token.email == 'saudiali044@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN')
      );
    }

    function isUserActive() {
      return isSignedIn() && (
        isSuperAdmin() ||
        request.auth.token.status == 'ACTIVE' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'ACTIVE')
      );
    }

    function isServerAuthorized() {
      return isSignedIn() && (
        request.auth.token.isServer == true ||
        request.auth.token.role == 'SYSTEM' ||
        isSuperAdmin()
      );
    }

    function isProjectMember(projectId) {
      return isUserActive() && (
        isSuperAdmin() ||
        (request.auth.token.assignedProjectIds != null && projectId in request.auth.token.assignedProjectIds) ||
        (request.auth.token.projectRoles != null && projectId in request.auth.token.projectRoles) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (projectId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedProjectIds ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN'))
      );
    }

    function hasProjectRole(projectId, allowedRoles) {
      return isUserActive() && (
        isSuperAdmin() ||
        (request.auth.token.role != null && request.auth.token.role in allowedRoles && isProjectMember(projectId)) ||
        (request.auth.token.projectRoles != null && request.auth.token.projectRoles[projectId] in allowedRoles) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in allowedRoles ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN') &&
         projectId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedProjectIds)
      );
    }

    // =========================================================================
    // 1. Projects Collection & Multi-Tenant Boundaries
    // =========================================================================
    match /projects/{projectId} {
      allow get: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        isProjectMember(projectId)
      );
      allow create: if isSuperAdmin() && isValidId(projectId) && 
                       isAuditStampedCreate(incoming()) &&
                       incoming().projectId == projectId &&
                       incoming().nameAr is string && incoming().nameAr.size() > 0 &&
                       incoming().nameAr.size() <= 200;
      allow update: if isSignedIn() && isValidId(projectId) &&
                       hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                       isAuditStampedUpdate(incoming()) &&
                       incoming().projectId == existing().projectId;
      allow delete: if false; // Soft-delete only via status

      // Carriers subcollection
      match /carriers/{carrierId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create: if isSignedIn() && isValidId(carrierId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                         isAuditStampedCreate(incoming()) &&
                         incoming().carrierId == carrierId &&
                         incoming().projectId == projectId;
        allow update: if isSignedIn() && isValidId(carrierId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                         isAuditStampedUpdate(incoming()) &&
                         incoming().carrierId == existing().carrierId &&
                         incoming().projectId == existing().projectId;
        allow delete: if false;
      }

      // Project Carrier Roster subcollection (BLOCK 87)
      match /roster/{rosterId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create: if isSignedIn() && isValidId(rosterId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                         isAuditStampedCreate(incoming()) &&
                         incoming().rosterId == rosterId &&
                         incoming().projectId == projectId;
        allow update: if isSignedIn() && isValidId(rosterId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                         isAuditStampedUpdate(incoming()) &&
                         incoming().rosterId == existing().rosterId &&
                         incoming().projectId == existing().projectId;
        allow delete: if false;
      }

      // Pricing Rules subcollection
      match /pricing_rules/{pricingRuleId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create: if isSignedIn() && isValidId(pricingRuleId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'FINANCE_AUDITOR', 'SUPER_ADMIN']) &&
                         isAuditStampedCreate(incoming()) &&
                         incoming().pricingRuleId == pricingRuleId &&
                         incoming().projectId == projectId &&
                         incoming().baseRateSAR is number;
        allow update: if isSignedIn() && isValidId(pricingRuleId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'FINANCE_AUDITOR', 'SUPER_ADMIN']) &&
                         isAuditStampedUpdate(incoming()) &&
                         incoming().pricingRuleId == existing().pricingRuleId &&
                         incoming().projectId == existing().projectId &&
                         incoming().baseRateSAR == existing().baseRateSAR; // Base rate is immutable once created (requires Copy-on-Write v2)
        allow delete: if false;
      }

      // Materials subcollection
      match /materials/{materialId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create: if isSignedIn() && isValidId(materialId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                         isAuditStampedCreate(incoming()) &&
                         incoming().materialId == materialId &&
                         incoming().projectId == projectId;
        allow update: if isSignedIn() && isValidId(materialId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                         isAuditStampedUpdate(incoming()) &&
                         incoming().materialId == existing().materialId &&
                         incoming().projectId == existing().projectId;
        allow delete: if false;
      }

      // Trucks subcollection
      match /trucks/{truckId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create: if isSignedIn() && isValidId(truckId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'DISPATCHER', 'SUPERVISOR', 'SUPER_ADMIN']) &&
                         isAuditStampedCreate(incoming()) &&
                         incoming().truckId == truckId &&
                         incoming().projectId == projectId &&
                         incoming().carrierId is string && incoming().carrierId.size() > 0;
        allow update: if isSignedIn() && isValidId(truckId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'DISPATCHER', 'SUPERVISOR', 'SUPER_ADMIN']) &&
                         isAuditStampedUpdate(incoming()) &&
                         incoming().truckId == existing().truckId &&
                         incoming().projectId == existing().projectId &&
                         incoming().carrierId == existing().carrierId; // Truck cannot be reassigned to another carrier
        allow delete: if false;
      }

      // Drivers subcollection
      match /drivers/{driverId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create: if isSignedIn() && isValidId(driverId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'DISPATCHER', 'SUPERVISOR', 'SUPER_ADMIN']) &&
                         isAuditStampedCreate(incoming()) &&
                         incoming().driverId == driverId &&
                         incoming().projectId == projectId &&
                         incoming().carrierId is string && incoming().carrierId.size() > 0;
        allow update: if isSignedIn() && isValidId(driverId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'DISPATCHER', 'SUPERVISOR', 'SUPER_ADMIN']) &&
                         isAuditStampedUpdate(incoming()) &&
                         incoming().driverId == existing().driverId &&
                         incoming().projectId == existing().projectId;
        allow delete: if false;
      }

      // =======================================================================
      // PHASE 6 — UNIT 2A: Project Membership Subcollections
      // Restricts write authority strictly to PROJECT_ADMIN and SUPER_ADMIN.
      // Read authority requires active project membership.
      // Enforces structural projectId, audit stamps, and key alignment.
      // =======================================================================
      match /driver_memberships/{driverId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create: if isSignedIn() && isValidId(driverId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                         isAuditStampedCreate(incoming()) &&
                         incoming().driverId == driverId &&
                         incoming().projectId == projectId &&
                         incoming().status in ['ACTIVE', 'SUSPENDED', 'REMOVED'];
        allow update: if isSignedIn() && isValidId(driverId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                         isAuditStampedUpdate(incoming()) &&
                         incoming().driverId == existing().driverId &&
                         incoming().projectId == existing().projectId &&
                         incoming().status in ['ACTIVE', 'SUSPENDED', 'REMOVED'];
        allow delete: if false;
      }

      match /truck_memberships/{truckId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create: if isSignedIn() && isValidId(truckId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                         isAuditStampedCreate(incoming()) &&
                         incoming().truckId == truckId &&
                         incoming().projectId == projectId &&
                         incoming().status in ['ACTIVE', 'SUSPENDED', 'REMOVED'];
        allow update: if isSignedIn() && isValidId(truckId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                         isAuditStampedUpdate(incoming()) &&
                         incoming().truckId == existing().truckId &&
                         incoming().projectId == existing().projectId &&
                         incoming().status in ['ACTIVE', 'SUSPENDED', 'REMOVED'];
        allow delete: if false;
      }

      match /carrier_memberships/{carrierId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create: if isSignedIn() && isValidId(carrierId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                         isAuditStampedCreate(incoming()) &&
                         incoming().carrierId == carrierId &&
                         incoming().projectId == projectId &&
                         incoming().status in ['ACTIVE', 'SUSPENDED', 'REMOVED'];
        allow update: if isSignedIn() && isValidId(carrierId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                         isAuditStampedUpdate(incoming()) &&
                         incoming().carrierId == existing().carrierId &&
                         incoming().projectId == existing().projectId &&
                         incoming().status in ['ACTIVE', 'SUSPENDED', 'REMOVED'];
        allow delete: if false;
      }

      match /material_memberships/{materialId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create: if isSignedIn() && isValidId(materialId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                         isAuditStampedCreate(incoming()) &&
                         incoming().materialId == materialId &&
                         incoming().projectId == projectId &&
                         incoming().status in ['ACTIVE', 'SUSPENDED', 'REMOVED'];
        allow update: if isSignedIn() && isValidId(materialId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                         isAuditStampedUpdate(incoming()) &&
                         incoming().materialId == existing().materialId &&
                         incoming().projectId == existing().projectId &&
                         incoming().status in ['ACTIVE', 'SUSPENDED', 'REMOVED'];
        allow delete: if false;
      }

      // =======================================================================
      // PHASE 6 — UNIT 2B-1: Project Carrier Fleet Affiliation Subcollections
      // Restricts write authority strictly to PROJECT_ADMIN and SUPER_ADMIN.
      // Read authority requires active project membership.
      // Enforces structural projectId, driverId/truckId alignment, carrierId validity, and audit stamps.
      // =======================================================================
      match /driver_carrier_affiliations/{driverId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create: if isSignedIn() && isValidId(driverId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                         isAuditStampedCreate(incoming()) &&
                         incoming().driverId == driverId &&
                         incoming().projectId == projectId &&
                         isValidId(incoming().carrierId) &&
                         incoming().status in ['ACTIVE', 'INACTIVE'];
        allow update: if isSignedIn() && isValidId(driverId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                         isAuditStampedUpdate(incoming()) &&
                         incoming().driverId == existing().driverId &&
                         incoming().projectId == existing().projectId &&
                         isValidId(incoming().carrierId) &&
                         incoming().status in ['ACTIVE', 'INACTIVE'];
        allow delete: if false;
      }

      match /truck_carrier_affiliations/{truckId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create: if isSignedIn() && isValidId(truckId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                         isAuditStampedCreate(incoming()) &&
                         incoming().truckId == truckId &&
                         incoming().projectId == projectId &&
                         isValidId(incoming().carrierId) &&
                         incoming().status in ['ACTIVE', 'INACTIVE'];
        allow update: if isSignedIn() && isValidId(truckId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                         isAuditStampedUpdate(incoming()) &&
                         incoming().truckId == existing().truckId &&
                         incoming().projectId == existing().projectId &&
                         isValidId(incoming().carrierId) &&
                         incoming().status in ['ACTIVE', 'INACTIVE'];
        allow delete: if false;
      }

      // Unit 2B-2: Driver ↔ Truck Temporal Assignment Subcollection
      match /driver_truck_assignments/{assignmentId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create: if isSignedIn() && isValidId(assignmentId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                         incoming().assignmentId == assignmentId &&
                         incoming().projectId == projectId &&
                         isValidId(incoming().driverId) &&
                         isValidId(incoming().truckId) &&
                         incoming().status in ['ACTIVE', 'CLOSED'] &&
                         incoming().createdBy == request.auth.uid;
        // Historical assignments can transition from ACTIVE to CLOSED only (fields are immutable once closed)
        allow update: if isSignedIn() && isValidId(assignmentId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                         existing().status == 'ACTIVE' &&
                         incoming().status == 'CLOSED' &&
                         incoming().assignmentId == existing().assignmentId &&
                         incoming().projectId == existing().projectId &&
                         incoming().driverId == existing().driverId &&
                         incoming().truckId == existing().truckId &&
                         incoming().effectiveFrom == existing().effectiveFrom &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().createdBy == existing().createdBy;
        allow delete: if false;
      }

      // Unit 2B-2: Active Driver Slot Concurrency Infrastructure
      match /driver_active_assignments/{driverId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create, update: if isSignedIn() && isValidId(driverId) &&
                                 hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                                 isValidId(incoming().assignmentId);
        allow delete: if isSignedIn() && isValidId(driverId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']);
      }

      // Unit 2B-2: Active Truck Slot Concurrency Infrastructure
      match /truck_active_assignments/{truckId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create, update: if isSignedIn() && isValidId(truckId) &&
                                 hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                                 isValidId(incoming().assignmentId);
        allow delete: if isSignedIn() && isValidId(truckId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']);
      }

      // Unit 2C: Truck ↔ Material Temporal Allocation Subcollection
      match /truck_material_allocations/{allocationId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create: if isSignedIn() && isValidId(allocationId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                         incoming().allocationId == allocationId &&
                         incoming().projectId == projectId &&
                         isValidId(incoming().truckId) &&
                         isValidId(incoming().materialId) &&
                         incoming().status in ['ACTIVE', 'CLOSED'] &&
                         incoming().createdBy == request.auth.uid;
        // Historical allocations can transition from ACTIVE to CLOSED only (fields are immutable once closed)
        allow update: if isSignedIn() && isValidId(allocationId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                         existing().status == 'ACTIVE' &&
                         incoming().status == 'CLOSED' &&
                         incoming().allocationId == existing().allocationId &&
                         incoming().projectId == existing().projectId &&
                         incoming().truckId == existing().truckId &&
                         incoming().materialId == existing().materialId &&
                         incoming().effectiveFrom == existing().effectiveFrom &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().createdBy == existing().createdBy;
        allow delete: if false;
      }

      // Unit 2C: Active Truck Material Slot Concurrency Infrastructure
      match /truck_active_material_allocations/{truckId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create, update: if isSignedIn() && isValidId(truckId) &&
                                 hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']) &&
                                 isValidId(incoming().allocationId);
        allow delete: if isSignedIn() && isValidId(truckId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'SUPER_ADMIN']);
      }

      // Trips subcollection
      match /trips/{tripId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create: if isSignedIn() && isValidId(tripId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'DISPATCHER', 'SUPERVISOR', 'SUPER_ADMIN']) &&
                         isAuditStampedCreate(incoming()) &&
                         incoming().tripId == tripId &&
                         incoming().projectId == projectId &&
                         (isServerAuthorized() || !('tripNumber' in incoming()));
        allow update: if isSignedIn() && isValidId(tripId) &&
                         isProjectMember(projectId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'DISPATCHER', 'SUPERVISOR', 'FINANCE_AUDITOR', 'SUPER_ADMIN']) &&
                         isAuditStampedUpdate(incoming()) &&
                         incoming().tripId == existing().tripId &&
                         incoming().projectId == existing().projectId &&
                         incoming().carrierId == existing().carrierId && // Carrier immutable
                         incoming().truckId == existing().truckId && // Truck immutable
                         incoming().pricingRuleId == existing().pricingRuleId && // Pricing rule immutable
                         (!('tripNumber' in existing()) || incoming().tripNumber == existing().tripNumber) && // tripNumber immutable
                         // Snapshot & Financial Immutability Protection
                         (existing().pricingSnapshot == null || incoming().pricingSnapshot == null ||
                          (incoming().pricingSnapshot.agreedRate == existing().pricingSnapshot.agreedRate &&
                           incoming().pricingSnapshot.settlementAmount == existing().pricingSnapshot.settlementAmount)) &&
                         (existing().financials == null || existing().financials.isFinalized != true ||
                          (incoming().financials.isFinalized == true && incoming().financials.totalAmountSAR == existing().financials.totalAmountSAR)) &&
                         // Unloading, Weighbridge & Variance Workflow Protection (Gap 2)
                         (isServerAuthorized() ? (
                           // Server-authorized writes: enforce variance formula and prevent fake zero variance
                           (incoming().destNetWeight == null || existing().netWeight == null ||
                            (incoming().destNetWeight == existing().netWeight ? 
                               (incoming().varianceWeight == 0 && (existing().destNetWeight != null || incoming().unloadDecision == 'ACCEPT_ORIGIN_NET_AS_DESTINATION' || incoming().unloadingDataSource == 'WEIGHBRIDGE')) :
                               (incoming().varianceWeight == (incoming().destNetWeight - existing().netWeight)))) &&
                           (incoming().destNetWeight != null || incoming().varianceWeight == null || incoming().varianceWeight == existing().varianceWeight)
                         ) : (
                           // Direct client updates CANNOT mutate unloading workflow fields
                           (!('destNetWeight' in incoming()) || incoming().destNetWeight == existing().destNetWeight) &&
                           (!('varianceWeight' in incoming()) || incoming().varianceWeight == existing().varianceWeight) &&
                           (!('unloadTime' in incoming()) || incoming().unloadTime == existing().unloadTime) &&
                           (!('unloadingActorType' in incoming()) || incoming().unloadingActorType == existing().unloadingActorType) &&
                           (!('unloadingActorId' in incoming()) || incoming().unloadingActorId == existing().unloadingActorId) &&
                           (!('unloadingDataSource' in incoming()) || incoming().unloadingDataSource == existing().unloadingDataSource) &&
                           (!('unloadDecision' in incoming()) || incoming().unloadDecision == existing().unloadDecision)
                         ));
        allow delete: if false; // Tax/VAT compliance: trips cannot be hard-deleted

        // Trip Events (Strict Append-Only Event Stream)
        match /events/{eventId} {
          allow get, list: if isSignedIn() && isProjectMember(projectId);
          allow create: if isSignedIn() && isValidId(eventId) &&
                           isProjectMember(projectId) &&
                           isAuditStampedCreate(incoming()) &&
                           incoming().eventId == eventId &&
                           incoming().tripId == tripId &&
                           incoming().projectId == projectId;
          allow update, delete: if false; // Strictly Immutable Event Stream
        }

        // Trip Exceptions
        match /exceptions/{exceptionId} {
          allow get, list: if isSignedIn() && isProjectMember(projectId);
          allow create: if isSignedIn() && isValidId(exceptionId) &&
                           isProjectMember(projectId) &&
                           isAuditStampedCreate(incoming()) &&
                           incoming().exceptionId == exceptionId &&
                           incoming().tripId == tripId &&
                           incoming().projectId == projectId;
          allow update: if isSignedIn() && isValidId(exceptionId) &&
                           hasProjectRole(projectId, ['PROJECT_ADMIN', 'FINANCE_AUDITOR', 'SUPER_ADMIN']) &&
                           isAuditStampedUpdate(incoming()) &&
                           incoming().exceptionId == existing().exceptionId &&
                           incoming().tripId == existing().tripId &&
                           incoming().projectId == existing().projectId;
          allow delete: if false;
        }

        // Settlement Adjustments subcollection (BLOCK 87)
        match /adjustments/{adjustmentId} {
          allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
          allow create: if isSignedIn() && isValidId(adjustmentId) &&
                           hasProjectRole(projectId, ['PROJECT_ADMIN', 'FINANCE_AUDITOR', 'SUPER_ADMIN']) &&
                           isAuditStampedCreate(incoming()) &&
                           incoming().adjustmentId == adjustmentId &&
                           incoming().tripId == tripId &&
                           incoming().projectId == projectId;
          allow update: if isSignedIn() && isValidId(adjustmentId) &&
                           hasProjectRole(projectId, ['PROJECT_ADMIN', 'FINANCE_AUDITOR', 'SUPER_ADMIN']) &&
                           isAuditStampedUpdate(incoming()) &&
                           incoming().adjustmentId == existing().adjustmentId &&
                           incoming().tripId == existing().tripId &&
                           incoming().projectId == existing().projectId;
          allow delete: if false;
        }
      }

      // Sync Operations (Idempotency Journal)
      match /sync_operations/{operationId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create: if isSignedIn() && isValidId(operationId) &&
                         isProjectMember(projectId) &&
                         isAuditStampedCreate(incoming()) &&
                         incoming().operationId == operationId &&
                         incoming().projectId == projectId;
        allow update: if isSignedIn() && isValidId(operationId) &&
                         isProjectMember(projectId) &&
                         isAuditStampedUpdate(incoming()) &&
                         incoming().operationId == existing().operationId &&
                         incoming().projectId == existing().projectId;
        allow delete: if false;
      }

      // Import Batches
      match /import_batches/{batchId} {
        allow get, list: if isSignedIn() && isValidId(projectId) && isProjectMember(projectId);
        allow create: if isSignedIn() && isValidId(batchId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'DISPATCHER', 'SUPERVISOR', 'SUPER_ADMIN']) &&
                         isAuditStampedCreate(incoming()) &&
                         incoming().batchId == batchId &&
                         incoming().projectId == projectId;
        allow update: if isSignedIn() && isValidId(batchId) &&
                         hasProjectRole(projectId, ['PROJECT_ADMIN', 'DISPATCHER', 'SUPERVISOR', 'SUPER_ADMIN']) &&
                         isAuditStampedUpdate(incoming()) &&
                         incoming().batchId == existing().batchId &&
                         incoming().projectId == existing().projectId;
        allow delete: if false;
      }
    }

    // Collection Group Read Rule for Exceptions
    match /{path=**}/exceptions/{exceptionId} {
      allow get, list: if isSignedIn() && isProjectMember(resource.data.projectId);
    }

    // =========================================================================
    // 2. Global Users Collection
    // =========================================================================
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isUserActive());
      allow list: if isUserActive();
      allow create: if isSignedIn() && isValidId(userId) &&
                       (request.auth.uid == userId || isUserActive()) &&
                       isAuditStampedCreate(incoming()) &&
                       incoming().userId == userId;
      allow update: if isSignedIn() && isValidId(userId) &&
                       ((isSuperAdmin() && isUserActive()) || (request.auth.uid == userId && incoming().role == existing().role && incoming().status == existing().status)) &&
                       isAuditStampedUpdate(incoming()) &&
                       incoming().userId == existing().userId;
      allow delete: if false;
    }

    // =========================================================================
    // 3. Global Audit Logs Collection (Strict Append-Only with Actor Verification)
    // =========================================================================
    match /audit_logs/{auditLogId} {
      allow get, list: if isUserActive();
      allow create: if isSignedIn() && isValidId(auditLogId) &&
                       isAuditStampedCreate(incoming()) &&
                       incoming().auditLogId == auditLogId &&
                       (incoming().actor.userId == request.auth.uid ||
                        incoming().createdBy == request.auth.uid ||
                        isSuperAdmin());
      allow update, delete: if false; // Strictly Immutable
    }

    // =========================================================================
    // 4. Global Identity Authorities (Phase 6 Unit 1: Additive Foundation Only)
    // Interim restricted policy: SUPER_ADMIN and trusted server-authorized execution only.
    // Zero production consumers wired yet. Ordinary users cannot read arbitrary Driver PII or probe lookup tokens.
    // =========================================================================
    match /drivers/{driverId} {
      allow get, list: if isSuperAdmin() || isServerAuthorized();
      allow create: if isSignedIn() && isValidId(driverId) &&
                       isAuditStampedCreate(incoming()) &&
                       incoming().driverId == driverId &&
                       (isSuperAdmin() || isServerAuthorized());
      allow update: if isSignedIn() && isValidId(driverId) &&
                       isAuditStampedUpdate(incoming()) &&
                       incoming().driverId == existing().driverId &&
                       incoming().nationalId == existing().nationalId &&
                       (isSuperAdmin() || isServerAuthorized());
      allow delete: if false;
    }

    match /trucks/{truckId} {
      allow get, list: if isSuperAdmin() || isServerAuthorized();
      allow create: if isSignedIn() && isValidId(truckId) &&
                       isAuditStampedCreate(incoming()) &&
                       incoming().truckId == truckId &&
                       (isSuperAdmin() || isServerAuthorized());
      allow update: if isSignedIn() && isValidId(truckId) &&
                       isAuditStampedUpdate(incoming()) &&
                       incoming().truckId == existing().truckId &&
                       incoming().normalizedPlate == existing().normalizedPlate &&
                       (isSuperAdmin() || isServerAuthorized());
      allow delete: if false;
    }

    match /carriers/{carrierId} {
      allow get, list: if isSuperAdmin() || isServerAuthorized();
      allow create: if isSignedIn() && isValidId(carrierId) &&
                       isAuditStampedCreate(incoming()) &&
                       incoming().carrierId == carrierId &&
                       (isSuperAdmin() || isServerAuthorized());
      allow update: if isSignedIn() && isValidId(carrierId) &&
                       isAuditStampedUpdate(incoming()) &&
                       incoming().carrierId == existing().carrierId &&
                       incoming().commercialRegistrationNo == existing().commercialRegistrationNo &&
                       (isSuperAdmin() || isServerAuthorized());
      allow delete: if false;
    }

    match /materials/{materialId} {
      // Material catalog is non-sensitive domain master data
      allow get, list: if isUserActive();
      allow create: if isSignedIn() && isValidId(materialId) &&
                       isAuditStampedCreate(incoming()) &&
                       incoming().materialId == materialId &&
                       (isSuperAdmin() || isServerAuthorized());
      allow update: if isSignedIn() && isValidId(materialId) &&
                       isAuditStampedUpdate(incoming()) &&
                       incoming().materialId == existing().materialId &&
                       incoming().code == existing().code &&
                       (isSuperAdmin() || isServerAuthorized());
      allow delete: if false;
    }

    // Natural Identity Atomic Reservation Lookups
    // Zero ordinary client get/list/write to eliminate low-entropy token enumeration/probing
    match /natural_identity_lookups/{token} {
      allow get, list: if isSuperAdmin() || isServerAuthorized();
      allow create: if isSignedIn() && isValidId(token) &&
                       (isSuperAdmin() || isServerAuthorized());
      allow update, delete: if false;
    }
  }
}

